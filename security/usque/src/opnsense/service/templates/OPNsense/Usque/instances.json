{
  "enabled": {{ "true" if not helpers.empty('OPNsense.usque.general.enabled') else "false" }},
  "instances": [
{% if helpers.exists('OPNsense.usque.tunnels.tunnel') %}
{%   for tunnel in helpers.toList('OPNsense.usque.tunnels.tunnel') %}
    {
      "id": {{ tunnel['@uuid'] | tojson }},
      "enabled": {{ "true" if tunnel.enabled == '1' else "false" }},
      "name": {{ tunnel.name | tojson }},
      "role": {{ tunnel.role | tojson }},
      "interface": {{ tunnel.interface | tojson }},
      "mesh_return_routes_enabled": {{ "false" if tunnel.mesh_return_routes_enabled == "0" else "true" }},
      "mesh_return_route_ipv4": {{ tunnel.mesh_return_route_ipv4 | tojson }},
      "mesh_return_route_ipv6": {{ tunnel.mesh_return_route_ipv6 | tojson }}
    }{{ "," if not loop.last else "" }}
{%   endfor %}
{% endif %}
  ]
}
