<model>
    <mount>//OPNsense/usque</mount>
    <version>0.2.0</version>
    <description>usque tunnel settings</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
        </general>
        <tunnels>
            <tunnel type="ArrayField">
            <enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </enabled>
            <name type="TextField">
                <Required>Y</Required>
                <Mask>/^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$/</Mask>
                <ValidationMessage>Use 1-64 letters, numbers, dots, underscores or dashes.</ValidationMessage>
            </name>
            <role type="OptionField">
                <Required>Y</Required>
                <Default>client</Default>
                <OptionValues>
                    <client>Egress client</client>
                    <mesh-node>Ingress Mesh node</mesh-node>
                </OptionValues>
            </role>
            <interface type="TextField">
                <Required>Y</Required>
                <Mask>/^tun[0-9]{1,3}$/</Mask>
                <ValidationMessage>Use an unused FreeBSD TUN interface name from tun0 through tun999.</ValidationMessage>
            </interface>
            <team type="TextField">
                <Mask>/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/</Mask>
                <ValidationMessage>Use the Cloudflare team subdomain only.</ValidationMessage>
            </team>
            <description type="DescriptionField"/>
            </tunnel>
        </tunnels>
    </items>
</model>
